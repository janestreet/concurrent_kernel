opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/janestreet/concurrent_kernel"
bug-reports: "https://github.com/janestreet/concurrent_kernel/issues"
dev-repo: "git+https://github.com/janestreet/concurrent_kernel.git"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/concurrent_kernel/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.2.0"}
  "await"
  "base"
  "portable"
  "ppx_debug_assert"
  "ppx_jane"
  "base-threads"
  "dune"             {>= "3.17.0"}
]
available: arch != "x86_32"
conflicts: [
  "oxcaml-compiler" {< "5.2.0minus39"}
]
synopsis: "Core of the abstract interface to concurrency in OxCaml"
description: "
[Concurrent_kernel] is the core of [Concurrent], without [Concurrent.Io], so that
    libraries which [Io] depends on can use it without creating a dependency cycle. It also
    contains [Concurrent_in_thread], a systhread-based implementation.
"
